---
// Decorative side view of a layered detector with muon tracks bending in a magnet. Not data.
const { note } = Astro.props as { note: string };
const origin = { x: 24, y: 130 };
const kink = 195; // magnet centre
const stations = [70, 120, 170, 220, 270, 320];
const tracks = [[-0.45, -0.15], [-0.15, -0.3], [0.08, 0.22], [0.35, 0.18], [0.62, 0.02]];
const y = ([a, b]: number[], x: number) => {
  const yk = origin.y + a * (kink - origin.x);
  return x <= kink ? origin.y + a * (x - origin.x) : yk + b * (x - kink);
};
const r = (n: number) => Math.round(n * 10) / 10;
---
<figure class="detector-art">
  <svg viewBox="0 0 340 260" aria-hidden="true" focusable="false">
    <rect class="magnet" x="180" y="24" width="30" height="212" />
    {stations.map((x) => <line class="station" x1={x} y1="24" x2={x} y2="236" />)}
    <rect class="target" x="12" y="118" width="12" height="24" />
    {tracks.map((s, i) => (
      <g style={`--d:${i * 0.12}s`}>
        <path class="track" pathLength="1" d={`M${origin.x} ${origin.y}L${kink} ${r(y(s, kink))}L320 ${r(y(s, 320))}`} />
        {stations.map((x) => <circle class="hit" cx={x} cy={r(y(s, x))} r="2.6" style={`--h:${r(i * 0.12 + (0.9 * (x - origin.x)) / 296)}s`} />)}
      </g>
    ))}
  </svg>
  <figcaption>{note}</figcaption>
</figure>
