---
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { copy, pages, profile, sitePath, type Locale } from '../data/site';

const { locale, page, title, description } = Astro.props as { locale: Locale; page: string; title: string; description: string };
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const suffix = page === 'home' ? '/' : `/${page}/`;
const canonical = new URL(`${base}${locale === 'es' ? '/es' : ''}${suffix}`, Astro.site);
const alternateEn = new URL(`${base}${suffix}`, Astro.site);
const alternateEs = new URL(`${base}/es${suffix}`, Astro.site);
const fullTitle = page === 'home' ? `${profile.name} · ${profile.role[locale]}` : `${title} · ${profile.name}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: new URL(`${base}/`, Astro.site).href,
  jobTitle: profile.role[locale],
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.university },
  knowsAbout: t.interests,
  sameAs: [profile.github, profile.orcid],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#142329" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <noscript><style>.theme-toggle{display:none}</style></noscript>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="wordmark" href={sitePath('', locale)} aria-label={`${profile.name} — ${t.nav.home}`}><span class="wordmark-mark">FT</span><span>{profile.name}</span></a>
      <nav aria-label={t.navLabel}>
        {pages.map((path) => <a href={sitePath(path, locale)} aria-current={(path || 'home') === page ? 'page' : undefined}>{t.nav[path || 'home']}</a>)}
      </nav>
      <div class="header-tools"><a class="language-link" href={locale === 'en' ? alternateEs.pathname : alternateEn.pathname} lang={locale === 'en' ? 'es' : 'en'}>{t.language}</a><button class="theme-toggle" type="button" aria-label={t.theme} title={t.theme} aria-pressed="false"><span aria-hidden="true">◐</span></button></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>{t.footer}</span><a href={profile.orcid}>ORCID ↗</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      toggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        toggle.setAttribute('aria-pressed', String(dark));
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
