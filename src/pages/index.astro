---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { copy, profile, sitePath } from '../data/site';
const locale = 'en'; const t = copy[locale];
const projects = (await getCollection('projects')).filter(({data}) => data.featuredOrder).sort((a,b) => a.data.featuredOrder! - b.data.featuredOrder!).slice(0,4);
---
<BaseLayout locale={locale} page="home" title={t.nav.home} description={t.intro}>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{t.eyebrow}</p><h1>{t.title}</h1><p class="hero-lede">{t.intro}</p><div class="hero-links"><a class="button-link" href={sitePath('research', locale)}>{t.research}<span aria-hidden="true"> ↗</span></a><a class="text-link" href={sitePath('projects', locale)}>{t.moreProjects}</a></div></div>
    <aside class="identity-note"><p class="note-label">FIELD NOTE <span>01 / PROFILE</span></p><h2>{profile.name}</h2><p>{profile.role.en}</p><hr /><p>{profile.affiliation.en}</p><p class="muted">{profile.supervision.en}</p><div class="note-coordinates"><span>VALPARAÍSO</span><span>CHILE · PACIFIC</span></div></aside>
    <div class="hero-index"><span>RESEARCH NOTEBOOK</span><span>01 — 04</span></div>
  </section>
  <section class="section-band"><div class="wrap research-preview"><div class="section-heading"><span class="section-number">01</span><h2>{t.research}</h2></div><div><p class="section-lede">{t.researchText}</p><ul class="interest-list">{t.interests.map((item) => <li>{item}</li>)}</ul><a class="arrow-link" href={sitePath('research', locale)}>Read the research note <span aria-hidden="true">→</span></a></div></div></section>
  <section class="wrap section projects-preview"><div class="section-heading"><span class="section-number">02</span><h2>{t.projects}</h2></div><p class="section-lede project-intro">{t.projectsText}</p><div class="project-grid">{projects.slice(0,3).map((project) => <ProjectCard project={project} locale={locale} />)}</div><a class="arrow-link" href={sitePath('projects', locale)}>{t.moreProjects} <span aria-hidden="true">→</span></a></section>
  <section class="cv-strip"><div class="wrap cv-strip-inner"><div><span class="eyebrow">03 / PROFILE</span><h2>{t.cv}</h2><p>{t.cvText}</p></div><a class="button-link" href={sitePath('cv', locale)}>{t.cvLink}<span aria-hidden="true"> ↗</span></a></div></section>
  <section class="wrap contact-strip"><span class="section-number">04</span><div><h2>{t.contact}</h2><p>{t.contactText}</p></div><a class="arrow-link" href={sitePath('contact', locale)}>GitHub · ORCID <span aria-hidden="true">→</span></a></section>
</BaseLayout>
