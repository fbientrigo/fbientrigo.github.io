---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DetectorArt from '../../components/DetectorArt.astro';
import { getCollection } from 'astro:content';
import { copy, profile, sitePath, type Locale } from '../../data/site';
export const getStaticPaths = () => [{ params: { lang: undefined } }, { params: { lang: 'es' } }];
const locale: Locale = Astro.params.lang === 'es' ? 'es' : 'en';
const t = copy[locale];
const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featuredOrder)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!)
  .slice(0, 3);
---
<BaseLayout locale={locale} page="home" title={t.nav.home} description={t.intro}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{profile.name}</h1>
      <p class="hero-role">{profile.role[locale]}</p>
      <p class="hero-lede">{t.intro}</p>
      <div class="hero-links">
        <a class="button-link" href={sitePath('research', locale)}>{t.research}<span aria-hidden="true"> →</span></a>
        <a class="text-link" href={sitePath('projects', locale)}>{t.moreProjects}</a>
      </div>
    </div>
    <div class="hero-side">
      <DetectorArt note={t.artNote} />
      <aside class="hero-meta">
        <p>{profile.affiliation[locale]}</p>
        <p>{profile.supervision[locale]}</p>
        <div class="profile-links">
          <a href={profile.github} target="_blank" rel="noreferrer">GitHub<span aria-hidden="true"> ↗</span></a>
          <a href={profile.orcid} target="_blank" rel="noreferrer">ORCID<span aria-hidden="true"> ↗</span></a>
        </div>
      </aside>
    </div>
  </section>
  <section class="section-band">
    <div class="wrap research-preview">
      <div class="section-heading"><h2>{t.research}</h2></div>
      <div>
        <p class="section-lede">{t.researchText}</p>
        <ul class="interest-list">{t.interests.map((item) => <li>{item}</li>)}</ul>
        <a class="arrow-link" href={sitePath('research', locale)}>{t.readResearch} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="wrap section projects-preview">
    <div class="section-heading"><h2>{t.projects}</h2></div>
    <p class="section-lede project-intro">{t.projectsText}</p>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div>
    <a class="arrow-link" href={sitePath('projects', locale)}>{t.moreProjects} <span aria-hidden="true">→</span></a>
  </section>
  <section class="cv-strip">
    <div class="wrap cv-strip-inner">
      <div><h2>{t.cv}</h2><p>{t.cvText}</p></div>
      <a class="button-link" href={sitePath('cv', locale)}>{t.cvLink}<span aria-hidden="true"> →</span></a>
    </div>
  </section>
  <section class="wrap contact-strip">
    <div><h2>{t.contact}</h2><p>{t.contactText}</p></div>
    <a class="arrow-link" href={sitePath('contact', locale)}>{t.contactLink} <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
