---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { copy, profile, sitePath, type Locale } from '../../data/site';
import { ANGLE, BACKGROUND, FIELD, MOMENTUM, disCounts, escapes } from '../../scripts/muon-shield';
export const getStaticPaths = () => [{ params: { lang: undefined } }, { params: { lang: 'es' } }];
const locale: Locale = Astro.params.lang === 'es' ? 'es' : 'en';
const t = copy[locale];
const h = t.home;
const captions: Partial<Record<string, string>> = h.artifactCaptions;
const defaultEscapes = escapes(FIELD.default);
const defaultDis = disCounts(FIELD.default);
const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featuredOrder)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!)
  .slice(0, 3);
---
<BaseLayout locale={locale} page="home" title={t.nav.home} description={t.intro}>
  <section class="wrap home-hero" aria-labelledby="home-title">
    <div>
      <p class="chapter-tag">{h.heroTag}</p>
      <h1 id="home-title">{profile.name}</h1>
      <p class="hero-statement" set:html={h.statement} />
      <dl class="resume-strip">
        <div><dt>{h.programme}</dt><dd>{profile.affiliation[locale]} · {profile.supervision[locale]}</dd></div>
        <div><dt>{h.methods}</dt><dd>{h.methodsText}</dd></div>
      </dl>
    </div>
    <figure class="stage">
      <canvas id="flow-canvas" class="stage-canvas" aria-hidden="true"></canvas>
      <figcaption class="stage-caption"><span>{h.flowCaption}</span><span class="stage-note">{t.artNote}</span></figcaption>
    </figure>
  </section>

  <section class="home-shield" aria-labelledby="shield-title">
    <div class="wrap shield-header">
      <div>
        <p class="chapter-tag">{h.shieldTag}</p>
        <h2 id="shield-title" class="chapter-heading">{h.shieldHeading}</h2>
        <p class="chapter-prose">{h.shieldText}</p>
        <p class="chapter-prose no-js-hidden">{h.shieldHow}</p>
        <p class="shield-punch">{h.shieldPunch} <a class="arrow-link" href={sitePath('research', locale)}>{t.readResearch} <span aria-hidden="true">→</span></a></p>
      </div>
      <div class="shield-panel no-js-hidden">
        <fieldset>
          <legend>{h.probeLabel}</legend>
          <label for="probe-p">{h.pLabel}</label>
          <input id="probe-p" type="range" min={MOMENTUM.min} max={MOMENTUM.max} step="1" value="120" />
          <label for="probe-theta">{h.thetaLabel}</label>
          <input id="probe-theta" type="range" min={-ANGLE.max} max={ANGLE.max} step="1" value="0" />
          <div class="charge-toggle" role="group" aria-label={h.chargeLabel}>
            <span aria-hidden="true">{h.chargeLabel}</span>
            <button type="button" data-charge="1" aria-pressed="true">μ⁺</button>
            <button type="button" data-charge="-1" aria-pressed="false">μ⁻</button>
          </div>
          <button type="button" class="reroll-button" data-reroll>{h.reroll}</button>
        </fieldset>
        <p class="probe-readout" data-probe-readout data-swept={h.swept} data-reaches={h.reaches} data-dis-yes={h.disYes} data-dis-no={h.disNo} data-danger-yes={h.dangerYes} data-danger-no={h.dangerNo}>μ⁺ · 120 GeV/c · 0 mrad → {h.swept}</p>
        <label for="shield-field">{h.fieldLabel}</label>
        <input id="shield-field" type="range" min={FIELD.min} max={FIELD.max} step="0.1" value={FIELD.default} />
        <p class="escapes-readout" aria-live="polite" data-escapes-readout data-template={h.escapes} data-escapes={defaultEscapes}>{h.escapes.replace('{n}', String(defaultEscapes)).replace('{total}', String(BACKGROUND))}</p>
        <p class="escapes-readout" aria-live="polite" data-funnel-readout data-template={h.funnel} data-dis={defaultDis.dis} data-dangerous={defaultDis.dangerous}>{h.funnel.replace('{dis}', String(defaultDis.dis)).replace('{total}', String(BACKGROUND)).replace('{danger}', String(defaultDis.dangerous))}</p>
      </div>
    </div>
    <figure class="shield-band">
      <canvas id="shield-canvas" class="stage-canvas" aria-hidden="true"></canvas>
      <figcaption class="wrap shield-labels"><span>{h.panLeft}</span><span class="shield-label-mid">{h.panMid}</span><span class="stage-note">{h.panRight}</span></figcaption>
    </figure>
  </section>

  <section class="wrap home-artifacts" aria-labelledby="artifacts-title">
    <p class="chapter-tag">{h.artifactsTag}</p>
    <h2 id="artifacts-title" class="chapter-heading">{h.artifactsHeading}</h2>
    <div class="artifacts-split">
      <ol class="works" data-works>
        {projects.map(({ id, data }, i) => (
          <li class="work-item" data-glyph={data.glyph} data-caption={captions[data.glyph] ?? ''} data-active={String(i === 0)}>
            <h3><button type="button" aria-expanded="true" aria-controls={`work-${id}`}><span class="work-index">{String(data.featuredOrder).padStart(2, '0')}</span><span class="work-title">{data.title[locale]}</span></button></h3>
            <p class="work-domain">{data.tags.join(' · ')}</p>
            <div class="work-body" id={`work-${id}`}>
              <p>{data.description[locale]}</p>
              <a href={data.repositoryUrl} target="_blank" rel="noreferrer">{new URL(data.repositoryUrl).pathname.slice(1)}<span aria-hidden="true"> ↗</span></a>
            </div>
          </li>
        ))}
      </ol>
      <figure class="stage">
        <canvas id="work-canvas" class="stage-canvas" aria-hidden="true"></canvas>
        <figcaption class="stage-caption"><span data-work-caption>{captions[projects[0]?.data.glyph ?? ''] ?? ''}</span><span class="stage-note">{t.artNote}</span></figcaption>
      </figure>
    </div>
    <a class="arrow-link" href={sitePath('projects', locale)}>{t.moreProjects} <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<script>
  import '../../scripts/magnetic-ink';
</script>
